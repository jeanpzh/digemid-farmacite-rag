# Cloud Supabase configuration. Leave these unset when using the local Compose stack.
# SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/<database>
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Storage provider: supabase for cloud, s3 for the local SeaweedFS stack.
STORAGE_BACKEND=s3
STORAGE_BUCKET=documents
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin

# Local PostgreSQL defaults used by Docker Compose when SUPABASE_DB_URL is omitted.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag

CHAT_PROVIDER=groq
GROQ_API_KEY=<groq-api-key>
MODEL_NAME=qwen/qwen3.6-27b

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_PROJECT=digemid-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://localhost:11434
VECTOR_COLLECTION=digemid
RETRIEVAL_MAX_DISTANCE=0.7
RETRIEVAL_MAX_RESULTS=12
CORS_ORIGINS=http://localhost:3000
FORWARDED_ALLOW_IPS=127.0.0.1
